def build_zones(sheets):
    places = sheets["PlaceName"]
    candidates = {}
    for key, row in sheets["Map"].items():
        if not re.fullmatch(r"[a-z]\d[ft]\d/\d{2}", row["Id"]):
            continue
        name = places[int(row["PlaceName"])]["Name"]
        sf = float(row["SizeFactor"])
        if not math.isfinite(sf) or sf <= 0:
            raise ValueError(f"Map {key}: invalid size factor")
        if name and (name not in candidates or key < candidates[name][0]):
            candidates[name] = (key, row["Id"], sf)
    zones = {}
    map_keys = {}
    for key, tc, weather, expansion in ZONES:
        if tc not in candidates:
            raise ValueError(f"{key}: no native field/town map for {tc}")
        map_key, image_id, sf = candidates[tc]
        map_keys[key] = map_key
        zones[key] = {"tc": tc, "image": f"https://v2.xivapi.com/api/asset/map/{image_id}",
                      "sf": sf, "weatherZone": weather, "exp": expansion}
    return zones, map_keys


def render_zones(zones):
    return ("/** zones.js — AUTO-GEN by tools/build_data.py; native same-version PlaceName/Map. */\n"
            + "window.SIGHTSEEING_ZONES = " + json.dumps(zones, ensure_ascii=False, indent=2) + ";\n")
