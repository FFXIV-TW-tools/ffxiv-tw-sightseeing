// validate-weather.mjs — 驗 weather.js 對 vendored canonical 快照 bit-exact。用法：node tools/validate-weather.mjs
import fs from 'fs';
import { isDeepStrictEqual } from 'node:util';

const src = fs.readFileSync(new URL('../modules/weather.js', import.meta.url), 'utf8');
const Weather = new Function('window', src + '\nreturn window.Weather;')({});
const canonicalSrc = fs.readFileSync(new URL('./sources/cycleapple-weather.js', import.meta.url), 'utf8');
const Canonical = new Function(canonicalSrc + '\nreturn Weather;')();
for (const [name, implementation] of [['Weather', Weather], ['Canonical', Canonical]]) {
  for (const method of ['calculateWeatherSeed', 'getWeatherForZone', 'getAvailableZones']) {
    if (!implementation || typeof implementation[method] !== 'function') {
      console.error(`✗ ${name}.${method} 不存在`);
      process.exit(1);
    }
  }
}

// Golden（由 cycleapple 原版產出，且已對標 canonical FFXIV 天氣演算法 seed=53/61）
const GOLDEN = [
  ['Limsa Lominsa', 1700000000, 'Fair Skies'],
  ['Limsa Lominsa', 1700001400, 'Clouds'],
  ['Coerthas Central Highlands', 1700000000, 'Snow'],
  ["Ul'dah", 1700005000, 'Fair Skies'],
  ['The Crystarium', 1720000000, 'Clouds'],
  ['Kugane', 1720000000, 'Fair Skies'],
  ['Thavnair', 1720000000, 'Fair Skies'],
];
const errs = [];
for (const [z, t, want] of GOLDEN) {
  const got = Weather.getWeatherForZone(z, t);
  if (got !== want) errs.push(`getWeatherForZone(${z}, ${t}) = ${got} ≠ ${want}`);
}
// seed 不得因公開 API 消失而靜默跳過。
if (Weather.calculateWeatherSeed(1700000000) !== 53) errs.push('seed@1700000000 ≠ 53');
if (Weather.calculateWeatherSeed(1720000000) !== 61) errs.push('seed@1720000000 ≠ 61');

// 原始表及 alias 全量對照，避免少數 golden 剛好沒有碰到被改壞的區域。
for (const key of ['ZONE_WEATHER', 'ZONE_ALIASES']) {
  if (!Canonical[key] || !isDeepStrictEqual(Weather[key], Canonical[key])) errs.push(`${key} ≠ vendored canonical`);
}
const zones = [...new Set([...Canonical.getAvailableZones(), ...Object.keys(Canonical.ZONE_ALIASES)])].sort();
const timestamps = new Set([0, 1, 174, 175, 1399, 1400, 4199, 4200, 1700000000, 1720000000, 2147483647, 2147483648]);
const base = Math.floor(1700000000 / 1400) * 1400;
for (let period = 0; period < 512; period++) {
  for (const offset of [-1, 0, 1, 1399]) timestamps.add(base + period * 1400 + offset);
}
const samples = [...timestamps].sort((a, b) => a - b);
for (const timestamp of samples) {
  const expectedSeed = Canonical.calculateWeatherSeed(timestamp);
  if (Weather.calculateWeatherSeed(timestamp) !== expectedSeed) errs.push(`seed@${timestamp} ≠ canonical ${expectedSeed}`);
  for (const zone of zones) {
    const expected = Canonical.getWeatherForZone(zone, timestamp);
    const actual = Weather.getWeatherForZone(zone, timestamp);
    if (actual !== expected) errs.push(`getWeatherForZone(${zone}, ${timestamp}) = ${actual} ≠ canonical ${expected}`);
  }
}
if (errs.length) { console.error('✗ 天氣移植未對上：'); errs.forEach(e => console.error('  ' + e)); process.exit(1); }
console.log(`✓ 天氣移植 bit-exact 對上 golden + vendored canonical（${zones.length} zones/aliases × ${samples.length} 固定時間點 + seed + 全量天氣表）`);
